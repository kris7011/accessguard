{
  "spec_version": "1",
  "label": "Sample projects API",
  "target": {
    "origin": "http://127.0.0.1:8800",
    "path_prefixes": ["/api/v1"],
    "auth": { "kind": "header", "name": "X-Api-Key" }
  },
  "limits": { "max_requests": 300, "min_interval_seconds": 0.0, "max_duration_seconds": 120 },
  "checks": null,
  "policy": {
    "schema_version": "1",
    "id": "sample-projects-api",
    "description": "Intended read access of the synthetic projects API: organisations see their own projects, a roadmap shared from quasar to orbit, and billing for owners only.",
    "session_probe": { "path": "/api/v1/whoami", "subject_field": "data.email" },
    "identities": [
      { "id": "ana", "tenant": "orbit", "role": "owner", "subject": "ana@orbit.example" },
      { "id": "ben", "tenant": "orbit", "role": "viewer", "subject": "ben@orbit.example" },
      { "id": "cleo", "tenant": "quasar", "role": "owner", "subject": "cleo@quasar.example" },
      { "id": "dev", "tenant": "quasar", "role": "viewer", "subject": "dev@quasar.example" }
    ],
    "collections": [{ "id": "projects", "path": "/api/v1/projects" }],
    "resources": [
      {
        "id": "orbit-apollo",
        "category": "project",
        "path": "/api/v1/projects/prj-orbit-apollo",
        "owner": "ana",
        "collection": "projects",
        "protected_fields": ["data.name", "data.budget_code"],
        "grants": [{ "tenant": "orbit", "roles": ["owner", "viewer"] }]
      },
      {
        "id": "quasar-nova",
        "category": "project",
        "path": "/api/v1/projects/prj-quasar-nova",
        "owner": "cleo",
        "collection": "projects",
        "protected_fields": ["data.name", "data.budget_code"],
        "grants": [{ "tenant": "quasar", "roles": ["owner", "viewer"] }]
      },
      {
        "id": "quasar-roadmap",
        "category": "shared-project",
        "path": "/api/v1/projects/prj-quasar-roadmap",
        "owner": "cleo",
        "collection": "projects",
        "protected_fields": ["data.name", "data.budget_code"],
        "grants": [
          { "tenant": "quasar", "roles": ["owner", "viewer"] },
          { "tenant": "orbit", "roles": ["owner", "viewer"] }
        ]
      },
      {
        "id": "orbit-billing",
        "category": "billing",
        "path": "/api/v1/orgs/orbit/billing",
        "owner": "ana",
        "protected_fields": ["data.account_ref", "data.plan_note"],
        "grants": [{ "tenant": "orbit", "roles": ["owner"] }]
      },
      {
        "id": "quasar-billing",
        "category": "billing",
        "path": "/api/v1/orgs/quasar/billing",
        "owner": "cleo",
        "protected_fields": ["data.account_ref", "data.plan_note"],
        "grants": [{ "tenant": "quasar", "roles": ["owner"] }]
      }
    ]
  }
}
