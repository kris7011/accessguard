# AccessGuard control plane configuration. Copy to .env and replace every placeholder.
# Never commit .env. Values shown here are placeholders, not working credentials.

# --- Core ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
ACCESSGUARD_SECRET_KEY=replace-with-a-long-random-value
ACCESSGUARD_ENVIRONMENT=production
# Public hostname(s); 127.0.0.1 and web are needed for the container health check and the demo runner.
ACCESSGUARD_ALLOWED_HOSTS=app.example.com,127.0.0.1,web
ACCESSGUARD_CSRF_TRUSTED_ORIGINS=https://app.example.com
ACCESSGUARD_PUBLIC_URL=https://app.example.com
# TLS terminates at the reverse proxy, which also redirects http to https.
ACCESSGUARD_BEHIND_PROXY=true
# The proxy in docker-compose.prod.yml sets X-Forwarded-For; trust exactly that one hop.
ACCESSGUARD_TRUSTED_PROXY_HOPS=1
ACCESSGUARD_SSL_REDIRECT=false
ACCESSGUARD_SECURE_COOKIES=true
ACCESSGUARD_HSTS_SECONDS=31536000
ACCESSGUARD_ADMIN_PATH=ops-admin-replace-me/
ACCESSGUARD_LOG_LEVEL=INFO

# --- TLS proxy (docker-compose.prod.yml) ------------------------------------------------
# DNS A/AAAA records must point at the server before the first start (certificate via ACME).
ACCESSGUARD_DOMAIN=app.example.com
# Account e-mail for the certificate authority (expiry and problem notices).
ACME_EMAIL=ops@example.com

# --- Database --------------------------------------------------------------------------
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD; set DATABASE_URL yourself otherwise.
POSTGRES_PASSWORD=replace-with-a-strong-password
# DATABASE_URL=postgres://accessguard:password@db.example.internal:5432/accessguard  # pragma: allowlist secret
ACCESSGUARD_DB_SSLMODE=prefer

# --- E-mail (password reset) -----------------------------------------------------------
# Always STARTTLS; use the provider's port 587 (some hosts block outbound 25 and 465).
ACCESSGUARD_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
ACCESSGUARD_EMAIL_HOST=smtp.example.com
ACCESSGUARD_EMAIL_PORT=587
ACCESSGUARD_EMAIL_USER=replace-me
ACCESSGUARD_EMAIL_PASSWORD=replace-me
ACCESSGUARD_FROM_EMAIL=AccessGuard <no-reply@example.com>
ACCESSGUARD_ADMIN_EMAILS=ops@example.com

# --- Payments (Stripe; use test-mode keys until live payments are approved) --------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_TEAM=price_replace_me
STRIPE_PRICE_BUSINESS=price_replace_me
STRIPE_PORTAL_CONFIGURATION=bpc_replace_me
# Keys that are not test keys are refused unless this is true (needs explicit approval).
ACCESSGUARD_ALLOW_LIVE_PAYMENTS=false
ACCESSGUARD_PAYMENT_GRACE_DAYS=7

# --- AI assistance (optional; organisations must also opt in) ----------------------------
# anthropic | ollama | none
ACCESSGUARD_AI_PROVIDER=none
ACCESSGUARD_AI_MODEL=
ANTHROPIC_API_KEY=
ACCESSGUARD_AI_TIMEOUT_SECONDS=60

# --- Error monitoring (optional; any Sentry-compatible endpoint, e.g. self-hosted GlitchTip)
SENTRY_DSN=

# --- Off-site backups (docker-compose.prod.yml, restic) ----------------------------------
# SFTP to a storage box, e.g. sftp:backup-host:/accessguard with a "Host backup-host" entry
# in .secrets/ssh/config, or S3-compatible: s3:https://s3.<region>.example.com/<bucket>/accessguard
RESTIC_REPOSITORY=replace-with-the-repository
# Encrypts the backups. Without it they cannot be restored: keep a copy outside the server.
RESTIC_PASSWORD=replace-with-a-long-random-value
# Only for an S3 repository.
RESTIC_S3_ACCESS_KEY_ID=
RESTIC_S3_SECRET_ACCESS_KEY=
# Optional dead man's switch: pinged after each successful off-site run; alert when it stops.
ACCESSGUARD_BACKUP_HEARTBEAT_URL=

# --- Runner download (self-serve install) ----------------------------------------------
# A checked wheel copied to ./dist on the server; signed-in members download it with its SHA-256.
ACCESSGUARD_RUNNER_WHEEL=/dist/accessguard-0.3.0-py3-none-any.whl

# --- Demo --------------------------------------------------------------------------------
ACCESSGUARD_DEMO_FLAWED_ORIGIN=http://127.0.0.1:8800
ACCESSGUARD_DEMO_FIXED_ORIGIN=http://127.0.0.1:8801
ACCESSGUARD_SCAN_LEASE_SECONDS=120
